# Copy to .env and adjust. Everything has a working offline default.

# --- Embeddings (API and worker MUST match; see contracts/README.md) -------------------
# hash   : offline deterministic lexical embedding (default, no network)
# ollama : nomic-embed-text via the ollama profile (EMBEDDING_BASE_URL=http://ollama:11434)
# openai : text-embedding-3-small (set EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Answer generation ---------------------------------------------------------------------
# extractive : offline, quotes the best-matching evidence sentences (default)
# anthropic  : Claude via the Messages API (set ANTHROPIC_API_KEY)
# ollama     : local model via the ollama profile (LLM_BASE_URL=http://ollama:11434, LLM_MODEL=llama3.2)
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5
LLM_BASE_URL=
ANTHROPIC_API_KEY=

# --- Retrieval (§9.2). The defaults below were selected by the evaluation sweep for hash-v1
# (eval/reports/sweep-hash-v1.json). Re-run the sweep whenever the embedding model changes:
#   make sweep
# The design-doc defaults for a semantic embedding model are 512 / 64 / 0.65 / 0.
CHUNK_SIZE_TOKENS=128
CHUNK_OVERLAP_TOKENS=0
RETRIEVAL_TOP_K=5
RETRIEVAL_FLOOR=0.15
RETRIEVAL_RELATIVE_FLOOR=0.7
CACHE_SEMANTIC_THRESHOLD=0.97

# --- Limits -------------------------------------------------------------------------------
RATELIMIT_TOKENS_PER_MINUTE=60
RATELIMIT_BURST=20
LLM_RETRY_MAX_ATTEMPTS=3
WORKER_BATCH_SIZE=32

# --- Security -----------------------------------------------------------------------------
# HS256 signing key, >= 32 bytes. DEV_TOKEN_ENABLED exposes POST /api/v1/auth/dev-token:
# never enable it outside local development.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
DEV_TOKEN_ENABLED=true
POSTGRES_PASSWORD=insightrag
