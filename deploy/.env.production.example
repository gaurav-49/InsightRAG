# Copy to .env on the server:  cp deploy/.env.production.example .env
# Then replace every CHANGE_ME value.

# Public hostname pointing at this server (free options: DuckDNS, or <ip-with-dashes>.sslip.io)
DOMAIN=CHANGE_ME.duckdns.org

# Generate each with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Answer generation: extractive (offline, free) | anthropic (set ANTHROPIC_API_KEY) | ollama
LLM_PROVIDER=extractive
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Embeddings (API and worker share these). hash = offline and free.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Retrieval settings tuned for the hash embedding (see eval/reports/sweep-hash-v1.json)
CHUNK_SIZE_TOKENS=128
CHUNK_OVERLAP_TOKENS=0
RETRIEVAL_FLOOR=0.15
RETRIEVAL_RELATIVE_FLOOR=0.7
